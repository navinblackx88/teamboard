# Vercel environment variables for TeamBoard (see DEPLOY-VERCEL.md). Set these in the Vercel dashboard.

# Postgres: the Neon integration sets both. Pooled URL at runtime, direct URL for build-time migrations.
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/teamboard?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.region.aws.neon.tech/teamboard?sslmode=require

JWT_ACCESS_SECRET=          # openssl rand -base64 48
JWT_REFRESH_SECRET=         # openssl rand -base64 48

# Real-time: Pusher Channels
REALTIME_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# Files: S3-compatible bucket with CORS allowing PUT from your domain
STORAGE_DRIVER=s3
S3_BUCKET=teamboard-files
S3_REGION=auto               # R2: auto · AWS: e.g. ap-south-1
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # omit for AWS S3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DIRECT_UPLOADS=true
MAX_UPLOAD_MB=25

CRON_SECRET=                # any random string; Vercel Cron sends it as a bearer token

# Optional
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=     # redirect URI: https://<domain>/api/v1/auth/google/callback
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS= EMAIL_FROM="TeamBoard <no-reply@yourdomain.com>"
# APP_URL=https://teamboard.yourdomain.com
# API_URL=https://teamboard.yourdomain.com
