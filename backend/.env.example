# Copy to .env for local development (npm run dev). Every value has a dev default.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

DATABASE_URL=postgres://pm:pm@localhost:5432/pm
# Leave unset to use an in-memory cache and single-node Socket.IO
REDIS_URL=redis://localhost:6379

# Required in production (>= 16 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Google OAuth2: create a "Web application" client in Google Cloud Console and add
#   Authorised redirect URI: {API_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Attachments: "local" (disk) or "s3" (AWS S3, Cloudflare R2, or Google Cloud Storage via its S3 XML API)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
# S3_BUCKET=teamboard-attachments
# S3_REGION=us-east-1
# S3_ENDPOINT=                 # e.g. https://storage.googleapis.com for GCS (use HMAC keys)
# S3_PUBLIC_ENDPOINT=          # only if browsers reach storage on a different host than the API
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=25

# Email: leave SMTP_HOST unset to log emails instead of sending them
# SMTP_HOST=localhost
# SMTP_PORT=1025
EMAIL_FROM=TeamBoard <no-reply@teamboard.local>

DEADLINE_CHECK_CRON_MINUTES=15
DEADLINE_WINDOW_HOURS=24
