{
  "name": "teamboard",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "seed": "npm run db:seed -w backend",
    "test": "npm test -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:migrate": "npm run db:migrate -w backend"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  }
}
